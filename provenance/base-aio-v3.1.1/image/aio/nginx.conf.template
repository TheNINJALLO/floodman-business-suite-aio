worker_processes auto;
pid /home/container/run/nginx.pid;
error_log /dev/stderr info;

events {
    worker_connections 2048;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    sendfile on;
    keepalive_timeout 65;
    client_max_body_size 50m;

    client_body_temp_path /home/container/tmp/nginx/client;
    proxy_temp_path /home/container/tmp/nginx/proxy;
    fastcgi_temp_path /home/container/tmp/nginx/fastcgi;
    uwsgi_temp_path /home/container/tmp/nginx/uwsgi;
    scgi_temp_path /home/container/tmp/nginx/scgi;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    map $http_x_forwarded_proto $fm_public_scheme {
        default $scheme;
        ~*^https https;
        ~*^http http;
    }

    # Internal static server for the genuine Gauzy Angular application.
    server {
        listen 127.0.0.1:4201;
        server_name gauzy-static;
        root /home/container/runtime/gauzy-web;

        location / {
            try_files $uri $uri/ /index.html;
        }
    }

    # Public Floodman/Gauzy Hub on the primary Pterodactyl allocation.
    server {
        listen 0.0.0.0:${SERVER_PORT} default_server;
        server_name _;

        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;

        location = /health/live {
            default_type application/json;
            add_header Cache-Control "no-store" always;
            return 200 '{"status":"ok","service":"floodman-gauzy-hub","release":"${HUB_RELEASE}"}';
        }

        location = /floodman-starting.html {
            alias /opt/floodman/hub/starting.html;
            add_header Cache-Control "no-store" always;
        }

        location ^~ /floodman-brand/ {
            alias /opt/floodman/hub/brand/;
            add_header Cache-Control "public, max-age=3600" always;
            add_header X-Content-Type-Options "nosniff" always;
        }

        location = /favicon.ico {
            return 302 /floodman-brand/floodman-mark.svg;
        }

        location = /floodman-hub.js {
            alias /opt/floodman/hub/hub.js;
            add_header Cache-Control "no-store" always;
        }

        location = /floodman-hub.css {
            alias /opt/floodman/hub/hub.css;
            add_header Cache-Control "no-store" always;
        }

        location = /floodman-hub-config.js {
            alias /home/container/runtime/hub/floodman-hub-config.js;
            add_header Cache-Control "no-store" always;
        }

        location ~ ^/(office(?:/|$)|setup(?:/|$)|login(?:/|$)|logout(?:/|$)|invite(?:/|$)) {
            proxy_pass http://127.0.0.1:8700;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fm_public_scheme;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_read_timeout 180s;
            proxy_send_timeout 180s;
        }

        location = /api {
            return 308 /api/;
        }

        location /api/ {
            proxy_pass http://127.0.0.1:3000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fm_public_scheme;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 180s;
            proxy_send_timeout 180s;
            proxy_buffering off;
        }

        location ~* \.(?:js|css)$ {
            proxy_pass http://127.0.0.1:4201;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fm_public_scheme;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header Accept-Encoding "";
            proxy_hide_header Cache-Control;
            proxy_hide_header Expires;
            add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
            add_header Pragma "no-cache" always;
            add_header Expires "0" always;
            proxy_read_timeout 180s;
            proxy_send_timeout 180s;
            sub_filter_types application/javascript text/javascript application/x-javascript text/css;
            sub_filter_once off;
            sub_filter 'http://localhost:${SERVER_PORT}' '$fm_public_scheme://$http_host';
            sub_filter 'http://127.0.0.1:${SERVER_PORT}' '$fm_public_scheme://$http_host';
        }

        location / {
            proxy_pass http://127.0.0.1:4201;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fm_public_scheme;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Accept-Encoding "";
            proxy_read_timeout 180s;
            proxy_send_timeout 180s;
            proxy_intercept_errors on;
            error_page 502 503 504 = /floodman-starting.html;
            proxy_hide_header Cache-Control;
            proxy_hide_header Expires;
            add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
            add_header Pragma "no-cache" always;
            add_header Expires "0" always;
            sub_filter_once off;
            sub_filter '<title>Gauzy</title>' '<title>Floodman Operations</title>';
            sub_filter '.js"' '.js?fmhub=${HUB_RELEASE}"';
            sub_filter '.css"' '.css?fmhub=${HUB_RELEASE}"';
            sub_filter '</head>' '<link rel="icon" type="image/svg+xml" href="/floodman-brand/floodman-mark.svg"><meta name="theme-color" content="#102443"><link rel="stylesheet" href="/floodman-hub.css"></head>';
            sub_filter '</body>' '<script src="/floodman-hub-config.js"></script><script src="/floodman-hub.js"></script></body>';
        }
    }
}
