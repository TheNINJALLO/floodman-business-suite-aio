worker_processes auto;
pid /home/container/run/nginx.pid;
error_log /home/container/logs/nginx-error.log warn;

events {
    worker_connections 2048;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    sendfile on;
    keepalive_timeout 65;
    client_max_body_size 50m;

    client_body_temp_path /home/container/tmp/nginx/client;
    proxy_temp_path /home/container/tmp/nginx/proxy;
    fastcgi_temp_path /home/container/tmp/nginx/fastcgi;
    uwsgi_temp_path /home/container/tmp/nginx/uwsgi;
    scgi_temp_path /home/container/tmp/nginx/scgi;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    # Preserve the browser-facing HTTPS scheme through Tailscale Serve. Some
    # proxy versions omit X-Forwarded-Proto or report the loopback HTTP hop;
    # the private :8443-:8447 listeners are nevertheless HTTPS to the user.
    map $http_host $fm_tls_port {
        default 0;
        ~*:844[3-7]$ 1;
    }

    map "$fm_tls_port|$http_x_forwarded_proto" $fm_public_scheme {
        default $scheme;
        ~^1\| https;
        ~^0\|https$ https;
        ~^0\|http$ http;
    }

    # Internal static server for the genuine Gauzy Angular application.
    server {
        listen 127.0.0.1:4201;
        server_name floodman-erp-static;
        root /home/container/runtime/gauzy-web;

        location / {
            try_files $uri $uri/ /index.html;
        }
    }

    # Public Floodman Operations Hub on the primary Pterodactyl allocation.
    server {
        listen 127.0.0.1:${SERVER_PORT} default_server;
        server_name _;

        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        # Keep redirects relative so Tailscale's HTTPS origin and :8443 port
        # survive the internal HTTP proxy hop.
        absolute_redirect off;

        # Stable private entry point. The root opens the adaptive Floodman
        # workspace and no longer depends on the upstream ERP frontend.
        location = / {
            add_header Cache-Control "no-store" always;
            return 302 /workspace?source=root&workspace=auto;
        }


        location = /health/live {
            access_log off;
            default_type application/json;
            add_header Cache-Control "no-store" always;
            return 200 '{"status":"ok","service":"floodman-operations-hub","release":"${HUB_RELEASE}"}';
        }

        # Same-origin health probe for the Office workspace. The PWA uses this
        # instead of navigator.onLine, which can incorrectly report offline on
        # private Tailscale-only connections.
        location = /office-health/live {
            access_log off;
            proxy_pass http://127.0.0.1:8700/health/live;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fm_public_scheme;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_connect_timeout 3s;
            proxy_read_timeout 6s;
            proxy_send_timeout 6s;
            add_header Cache-Control "no-store" always;
        }

        location = /floodman-starting.html {
            alias /home/container/runtime/floodman-v4.6.7/app-overlay/floodman-operations-v4.6.7/hub/starting.html;
            add_header Cache-Control "no-store" always;
        }

        location ^~ /floodman-brand/ {
            alias /home/container/runtime/floodman-v4.6.7/app-overlay/floodman-operations-v4.6.7/hub/brand/;
            add_header Cache-Control "public, max-age=3600" always;
            add_header X-Content-Type-Options "nosniff" always;
        }

        location = /favicon.ico {
            return 302 /floodman-brand/floodman-mark.svg;
        }

        location = /floodman-hub.js {
            alias /home/container/runtime/floodman-v4.6.7/app-overlay/floodman-operations-v4.6.7/hub/hub.js;
            add_header Cache-Control "no-store" always;
        }

        location = /floodman-hub.css {
            alias /home/container/runtime/floodman-v4.6.7/app-overlay/floodman-operations-v4.6.7/hub/hub.css;
            add_header Cache-Control "no-store" always;
        }

        location = /floodman-hub-config.js {
            alias /home/container/runtime/hub/floodman-hub-config.js;
            add_header Cache-Control "no-store" always;
        }

        # Full ERP browser guard and status page. These files are generated by
        # the active launcher and deliberately bypass the service-worker cache.
        location = /floodman-boot-guard.js {
            alias /home/container/runtime/floodman-v4.6.7/floodman-boot-guard.js;
            default_type application/javascript;
            add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        }

        location = /floodman-status.html {
            alias /home/container/runtime/floodman-v4.6.7/floodman-status.html;
            default_type text/html;
            add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        }

        location = /floodman-login {
            return 302 /full-erp?target=login;
        }

        location = /erp-dashboard {
            return 302 /full-erp?target=dashboard;
        }

        location = /floodman-third-party-notices.html {
            alias /home/container/runtime/floodman-v4.6.7/app-overlay/floodman-operations-v4.6.7/hub/third-party-notices.html;
            add_header Cache-Control "public, max-age=3600" always;
            default_type text/html;
        }

        location = /manifest.webmanifest {
            alias /home/container/runtime/floodman-v4.6.7/app-overlay/floodman-operations-v4.6.7/pwa/manifest.webmanifest;
            default_type application/manifest+json;
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
            add_header X-Content-Type-Options "nosniff" always;
        }

        location = /floodman-sw.js {
            alias /home/container/runtime/floodman-v4.6.7/app-overlay/floodman-operations-v4.6.7/pwa/floodman-sw.js;
            default_type application/javascript;
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
            add_header Service-Worker-Allowed "/" always;
            add_header X-Content-Type-Options "nosniff" always;
        }

        location = /floodman-pwa.js {
            alias /home/container/runtime/floodman-v4.6.7/app-overlay/floodman-operations-v4.6.7/pwa/floodman-pwa.js;
            default_type application/javascript;
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        }

        location = /floodman-pwa.css {
            alias /home/container/runtime/floodman-v4.6.7/app-overlay/floodman-operations-v4.6.7/pwa/floodman-pwa.css;
            default_type text/css;
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        }

        location = /floodman-workspace.css {
            alias /home/container/runtime/floodman-v4.6.7/app-overlay/floodman-operations-v4.6.7/pwa/workspace-mode.css;
            default_type text/css;
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        }

        location = /floodman-offline.html {
            alias /home/container/runtime/floodman-v4.6.7/app-overlay/floodman-operations-v4.6.7/pwa/offline.html;
            default_type text/html;
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        }

        location = /install-app {
            alias /home/container/runtime/floodman-v4.6.7/app-overlay/floodman-operations-v4.6.7/pwa/install.html;
            default_type text/html;
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        }

        location = /floodman-pwa-status.json {
            alias /home/container/runtime/floodman-v4.6.7/app-overlay/floodman-operations-v4.6.7/pwa/pwa-status.json;
            default_type application/json;
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        }

        location ^~ /floodman-pwa-icons/ {
            alias /home/container/runtime/floodman-v4.6.7/app-overlay/floodman-operations-v4.6.7/pwa/icons/;
            add_header Cache-Control "public, max-age=604800, immutable" always;
            add_header X-Content-Type-Options "nosniff" always;
        }


        # Explicit workspace entry points. The adaptive PWA start page selects
        # desktop for computers and mobile for phones/tablets without treating
        # every touch-enabled Windows computer as a phone.
        location = /workspace {
            alias /home/container/runtime/floodman-v4.6.7/app-overlay/floodman-operations-v4.6.7/pwa/workspace.html;
            default_type text/html;
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        }

        location = /full-erp {
            alias /home/container/runtime/floodman-v4.6.7/app-overlay/floodman-operations-v4.6.7/pwa/erp.html;
            default_type text/html;
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        }

        location = /erp {
            return 302 /full-erp;
        }

        location = /erp-login {
            return 302 /full-erp?target=login;
        }

        location = /erp-home {
            return 302 /full-erp?target=dashboard;
        }

        location = /desktop {
            return 302 /office/desktop?desktop=1;
        }

        location = /d {
            return 302 /office/desktop?desktop=1;
        }

        location = /mobile {
            return 302 /office/mobile?mobile=1;
        }

        location = /m {
            return 302 /office/mobile?mobile=1;
        }


        location = /roomflow {
            return 308 /roomflow/;
        }

        location = /__roomflow_auth {
            internal;
            proxy_pass http://127.0.0.1:8700/office/api/roomflow/auth-check;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Cookie $http_cookie;
            proxy_set_header X-Original-URI $request_uri;
        }

        location ^~ /roomflow/ {
            auth_request /__roomflow_auth;
            error_page 401 =302 /login?next=/office/roomflow;
            error_page 403 =302 /office;
            alias /home/container/data/roomflow/current/;
            index index.html;
            add_header Cache-Control "no-cache" always;
            add_header X-Frame-Options "SAMEORIGIN" always;
            add_header Content-Security-Policy "frame-ancestors 'self'" always;
        }

        location ~ ^/(office(?:/|$)|customer(?:/|$)|setup(?:/|$)|login(?:/|$)|logout(?:/|$)|invite(?:/|$)) {
            proxy_pass http://127.0.0.1:8700;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fm_public_scheme;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_read_timeout 180s;
            proxy_send_timeout 180s;
        }

        location = /api {
            return 308 /api/;
        }

        # The ERP user/me endpoint loads employee separately. Older browser
        # bundles incorrectly sent employee and employee.organization as ORM
        # relations, which causes EntityPropertyNotFoundError. Normalize this
        # one request at the same-origin gateway.
        location = /api/user/me {
            proxy_pass http://127.0.0.1:3000/api/user/me?relations=role%2Ctenant&includeEmployee=true&includeOrganization=true;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fm_public_scheme;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 180s;
            proxy_send_timeout 180s;
            proxy_buffering off;
        }

        location /api/ {
            proxy_pass http://127.0.0.1:3000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fm_public_scheme;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 180s;
            proxy_send_timeout 180s;
            proxy_buffering off;
        }

        location ~* \.(?:js|css)$ {
            proxy_pass http://127.0.0.1:4201;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fm_public_scheme;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header Accept-Encoding "";
            proxy_hide_header Cache-Control;
            proxy_hide_header Expires;
            add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
            add_header Pragma "no-cache" always;
            add_header Expires "0" always;
            proxy_read_timeout 180s;
            proxy_send_timeout 180s;
            sub_filter_types application/javascript text/javascript application/x-javascript text/css;
            sub_filter_once off;
            sub_filter 'http://localhost:${SERVER_PORT}' '$fm_public_scheme://$http_host';
            sub_filter 'http://127.0.0.1:${SERVER_PORT}' '$fm_public_scheme://$http_host';
            sub_filter 'http://0.0.0.0:${SERVER_PORT}' '$fm_public_scheme://$http_host';
        }

        location / {
            proxy_pass http://127.0.0.1:4201;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fm_public_scheme;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Accept-Encoding "";
            proxy_read_timeout 180s;
            proxy_send_timeout 180s;
            proxy_intercept_errors on;
            error_page 502 503 504 = /floodman-starting.html;
            proxy_hide_header Cache-Control;
            proxy_hide_header Expires;
            add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
            add_header Pragma "no-cache" always;
            add_header Expires "0" always;
            sub_filter_once off;
            sub_filter '<title>Gauzy</title>' '<title>Floodman Operations</title>';
            sub_filter '<title>Ever Gauzy</title>' '<title>Floodman Operations</title>';
            sub_filter '<meta name="application-name" content="Gauzy">' '<meta name="application-name" content="Floodman Operations">';
            sub_filter '.js"' '.js?fmhub=${HUB_RELEASE}"';
            sub_filter '.css"' '.css?fmhub=${HUB_RELEASE}"';
            sub_filter '</head>' '<link rel="icon" type="image/png" sizes="192x192" href="/floodman-pwa-icons/icon-192.png"><link rel="apple-touch-icon" href="/floodman-pwa-icons/apple-touch-icon-180.png"><link rel="manifest" href="/manifest.webmanifest"><meta name="theme-color" content="#102443"><meta name="mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"><meta name="apple-mobile-web-app-title" content="Floodman"><meta name="author" content="Josh Aldrich"><meta name="application-name" content="Floodman Operations"><link rel="stylesheet" href="/floodman-hub.css"><link rel="stylesheet" href="/floodman-pwa.css"></head>';
            sub_filter '</body>' '<script src="/floodman-hub-config.js"></script><script src="/floodman-hub.js"></script><script defer src="/floodman-pwa.js?release=${HUB_RELEASE}"></script><script defer src="/floodman-boot-guard.js?release=${HUB_RELEASE}"></script></body>';
        }
    }
}
