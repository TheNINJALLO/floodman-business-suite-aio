# Core Floodman runtime. Copy to a private file outside Git.
TZ=America/Detroit
FLOODMAN_RELEASE=pterodactyl-mobile-v4.7.3
FLOODMAN_COMPANY_NAME=Floodman
FLOODMAN_OWNER_FIRST_NAME=Josh
FLOODMAN_OWNER_LAST_NAME=Aldrich
FLOODMAN_OWNER_EMAIL=owner@example.com
FLOODMAN_OWNER_PASSWORD=REPLACE_WITH_LONG_UNIQUE_PASSWORD
FLOODMAN_PUBLIC_SCHEME=https
FLOODMAN_PUBLIC_HOST=floodman.oninetwork.com
FLOODMAN_PUBLIC_URL=https://floodman.oninetwork.com
FLOODMAN_DOCUMENSO_URL=https://sign.oninetwork.com
FLOODMAN_CUSTOMER_PUBLIC_URL=https://floodman.oninetwork.com/customer
FLOODMAN_MOBILE_API_PUBLIC_URL=https://api.oninetwork.com/mobile-api/
FLOODMAN_API_PUBLIC_URL=https://api.oninetwork.com
FLOODMAN_ENGINEERING_URL=https://lab.oninetwork.com
FLOODMAN_MOBILE_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# Allocations
SERVER_PORT=9000
DOCUMENSO_PORT=9001
MAILPIT_PORT=9002
ENGINEERING_PORT=9003
FLOODMAN_API_PORT=9004
# Mailpit stays loopback-only; do not attach a public hostname to port 9002.

# Database secrets
POSTGRES_ADMIN_PASSWORD=REPLACE_ME
FLOODMAN_DB_PASSWORD=REPLACE_ME
GAUZY_DB_PASSWORD=REPLACE_ME
DOCUMENSO_DB_PASSWORD=REPLACE_ME
AI_DB_PASSWORD=REPLACE_ME

# Gauzy / Floodman ERP
GAUZY_OWNER_EMAIL=owner@example.com
GAUZY_OWNER_PASSWORD=REPLACE_ME
GAUZY_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
GAUZY_REFRESH_SECRET=REPLACE_WITH_RANDOM_SECRET
GAUZY_SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
GAUZY_VERIFICATION_SECRET=REPLACE_WITH_RANDOM_SECRET

# Documenso signing
DOCUMENSO_NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
DOCUMENSO_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_SECRET
DOCUMENSO_ENCRYPTION_SECONDARY_KEY=REPLACE_WITH_RANDOM_SECRET
DOCUMENSO_SIGNING_PASSPHRASE=REPLACE_WITH_RANDOM_SECRET
DOCUMENSO_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET

# Internal service authentication
INTERNAL_HMAC_KEYS=primary:REPLACE_WITH_RANDOM_SECRET
AI_HMAC_KEYS=primary:REPLACE_WITH_RANDOM_SECRET
AI_CALLING_HMAC_KEYS=call-primary:REPLACE_WITH_RANDOM_SECRET

# Optional integrations
AI_CALLING_ENABLED=false
AI_CALLING_APPROVED=false
AI_CALLING_PROVIDER=deterministic
AI_CALLING_WEBHOOK_URL=
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
