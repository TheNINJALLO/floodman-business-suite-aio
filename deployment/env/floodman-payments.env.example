# Square must remain the card-data environment. Never store PAN or CVV in Floodman.
SQUARE_ENVIRONMENT=sandbox
SQUARE_BASE_URL=https://connect.squareupsandbox.com
SQUARE_APPLICATION_ID=REPLACE_WITH_SANDBOX_APPLICATION_ID
SQUARE_LOCATION_ID=REPLACE_WITH_LOCATION_ID
SQUARE_ACCESS_TOKEN=REPLACE_WITH_SERVER_ACCESS_TOKEN
SQUARE_WEBHOOK_SIGNATURE_KEY=REPLACE_WITH_WEBHOOK_SIGNATURE_KEY
SQUARE_VERSION=2026-01-22
SQUARE_DELIVERY_METHOD=EMAIL
