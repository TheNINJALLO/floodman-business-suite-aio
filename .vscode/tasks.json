{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Floodman: verify repository",
      "type": "shell",
      "command": "python3 scripts/verify_repo.py",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Floodman: regenerate inventories",
      "type": "shell",
      "command": "python3 scripts/generate_inventory.py",
      "problemMatcher": []
    },
    {
      "label": "Floodman: fetch RoomFlow",
      "type": "shell",
      "command": "bash scripts/fetch-roomflow.sh",
      "problemMatcher": []
    },
    {
      "label": "Android: compile debug Kotlin",
      "type": "shell",
      "command": "gradle --no-daemon :app:compileDebugKotlin",
      "options": { "cwd": "${workspaceFolder}/apps/android" },
      "problemMatcher": ["$gradle"]
    },
    {
      "label": "Android: build debug APK",
      "type": "shell",
      "command": "gradle --no-daemon :app:assembleDebug",
      "options": { "cwd": "${workspaceFolder}/apps/android" },
      "problemMatcher": ["$gradle"]
    }
  ]
}
